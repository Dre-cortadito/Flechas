{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flechas",
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "cortadito.games/flechas*",
      "zone_name": "cortadito.games"
    }
  ],
  // 2026-08-20: OFF. The direct <name>.workers.dev host served the game but
  // NOT /gate.js (that lives in the Cortadito Games hub), so the paywall
  // script 404d and the game fell open. The zone route below is the only
  // supported entrance. Re-enabling this reopens that bypass.
  "workers_dev": false
}
